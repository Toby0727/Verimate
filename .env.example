# Copy to .env and fill in real values. Never commit .env.

# Supabase（Project Settings → API Keys）。NEXT_PUBLIC_ 前缀会暴露给浏览器，只放可公开的值
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key（sb_secret_...），仅服务端使用，绕过 RLS，绝不能加 NEXT_PUBLIC_ 前缀
SECRET_KEY=

# 设为 true 才能访问 demo 页面；不设时只开放等候名单问卷（线上 production 不要设）
DEMO_ENABLED=
